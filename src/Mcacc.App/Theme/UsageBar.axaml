<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Mcacc.App.Controls">

  <ControlTheme x:Key="{x:Type controls:UsageBar}" TargetType="controls:UsageBar">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="3">
          <TextBlock Text="{TemplateBinding Text}"
                     FontSize="11"
                     Foreground="{DynamicResource Mcacc.TextTertiary}"
                     TextWrapping="NoWrap" />
          <Border Height="4"
                  CornerRadius="2"
                  Background="{DynamicResource Mcacc.SurfaceHover}"
                  BorderBrush="{DynamicResource Mcacc.Border}"
                  BorderThickness="1">
            <controls:FractionPanel Fraction="{TemplateBinding Fraction}">
              <!-- The fill color comes from the styles below; set here it would be a local value they cannot beat. -->
              <Border Name="PART_Fill" CornerRadius="2" />
            </controls:FractionPanel>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_Fill">
      <Setter Property="Background" Value="{DynamicResource Mcacc.Accent}" />
    </Style>

    <Style Selector="^[IsWarning=True] /template/ Border#PART_Fill">
      <Setter Property="Background" Value="{DynamicResource Mcacc.Danger}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
