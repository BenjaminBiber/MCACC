<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mcacc.App.ViewModels"
             xmlns:views="using:Mcacc.App.Views"
             x:Class="Mcacc.App.App"
             RequestedThemeVariant="Default">

  <!-- Explicit templates instead of a reflection view locator, so a missing view is a compile error. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:AccountPickerViewModel">
      <views:AccountPickerView />
    </DataTemplate>
    <DataTemplate DataType="vm:TargetPickerViewModel">
      <views:TargetPickerView />
    </DataTemplate>
    <DataTemplate DataType="vm:AccountInfoViewModel">
      <views:AccountInfoView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AccountEditorViewModel">
      <views:AccountEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:ConfirmDialogViewModel">
      <views:ConfirmDialogView />
    </DataTemplate>
    <DataTemplate DataType="vm:RemoveAccountDialogViewModel">
      <views:RemoveAccountDialogView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#D97757" />
        <ColorPaletteResources x:Key="Dark" Accent="#D97757" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MCACC/Theme/Typography.axaml" />
    <StyleInclude Source="avares://MCACC/Theme/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MCACC/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://MCACC/Theme/LaunchTile.axaml" />
        <ResourceInclude Source="avares://MCACC/Theme/UsageBar.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
