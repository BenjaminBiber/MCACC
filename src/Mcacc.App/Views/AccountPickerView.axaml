<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mcacc.App.ViewModels"
             xmlns:controls="using:Mcacc.App.Controls"
             x:Class="Mcacc.App.Views.AccountPickerView"
             x:DataType="vm:AccountPickerViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="16">

      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="caption" Text="{Binding Subtitle}" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="icon"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Top"
                ToolTip.Tip="{Binding RefreshTooltip}">
          <controls:MIcon Kind="Refresh" />
        </Button>
        <Button Grid.Column="2"
                Classes="icon"
                Command="{Binding OpenSettingsCommand}"
                VerticalAlignment="Top"
                ToolTip.Tip="{Binding SettingsTooltip}">
          <controls:MIcon Kind="Settings" />
        </Button>
      </Grid>

      <!-- The add tile is the last entry, so it takes the next free cell and the size of an account tile.
           ItemsControl clips by default, which would cut off the border of a tile lifted on hover. -->
      <ItemsControl x:Name="TileList" ItemsSource="{Binding Entries}" ClipToBounds="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:TileGrid MinColumnWidth="300" Spacing="12" XYFocus.NavigationModes="Enabled" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>
          <DataTemplate x:DataType="vm:AccountTileViewModel">
            <controls:LaunchTile Variant="Account"
                                 Title="{Binding Name}"
                                 Subtitle="{Binding Subtitle}"
                                 Badge="{Binding Badge}"
                                 ProviderBadge="{Binding ProviderBadge}"
                                 AvatarText="{Binding Initials}"
                                 AvatarBrush="{Binding AvatarBrush}"
                                 Command="{Binding $parent[ItemsControl].((vm:AccountPickerViewModel)DataContext).SelectCommand}"
                                 CommandParameter="{Binding}">
              <controls:LaunchTile.Overlay>
                <Button Classes="icon" Width="28" Height="28" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:AccountPickerViewModel)DataContext).MoreTooltip}">
                  <controls:MIcon Kind="MoreVert" FontSize="18" />
                  <!-- The flyout opens in its own popup, outside the visual tree, so it reaches the page by name, not by $parent. -->
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).InfoText}"
                                Command="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).OpenInfoCommand}"
                                CommandParameter="{Binding}">
                        <MenuItem.Icon>
                          <controls:MIcon Kind="Insights" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).EditText}"
                                Command="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).EditCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).RemoveText}"
                                IsVisible="{Binding !IsDefault}"
                                Command="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).OpenFolderText}"
                                Command="{Binding #TileList.((vm:AccountPickerViewModel)DataContext).OpenFolderCommand}"
                                CommandParameter="{Binding}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </controls:LaunchTile.Overlay>
              <controls:LaunchTile.Footer>
                <StackPanel Spacing="6" Margin="0,4,0,0">
                  <controls:UsageBar Label="{Binding FiveHour.Label}"
                                     Value="{Binding FiveHour.Value}"
                                     ResetText="{Binding FiveHour.ResetText}" />
                  <controls:UsageBar Label="{Binding SevenDay.Label}"
                                     Value="{Binding SevenDay.Value}"
                                     ResetText="{Binding SevenDay.ResetText}" />
                  <TextBlock Classes="caption muted"
                             FontSize="11"
                             Text="{Binding UsageHint}"
                             IsVisible="{Binding UsageHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </controls:LaunchTile.Footer>
            </controls:LaunchTile>
          </DataTemplate>
          <DataTemplate x:DataType="vm:AddAccountTileViewModel">
            <controls:LaunchTile Variant="Add"
                                 IconKind="Add"
                                 Title="{Binding Title}"
                                 Command="{Binding Command}" />
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
