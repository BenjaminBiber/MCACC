<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mcacc.App.ViewModels"
             xmlns:controls="using:Mcacc.App.Controls"
             x:Class="Mcacc.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,20" Spacing="18">

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="{Binding BackTooltip}">
          <controls:MIcon Kind="ArrowBack" />
        </Button>
        <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="body" Text="{Binding TerminalLabel}" />
        <ComboBox ItemsSource="{Binding Terminals}"
                  SelectedItem="{Binding SelectedTerminal}"
                  HorizontalAlignment="Left"
                  MinWidth="300">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TerminalChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsShellVisible}">
        <TextBlock Classes="body" Text="{Binding ShellLabel}" />
        <ComboBox ItemsSource="{Binding Shells}"
                  SelectedItem="{Binding SelectedShell}"
                  HorizontalAlignment="Left"
                  MinWidth="300">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ShellChoice">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- The label sits beside the knob; the Fluent default would print an English On/Off there. -->
      <StackPanel Spacing="2">
        <ToggleSwitch IsChecked="{Binding CloseAfterLaunch}"
                      OnContent="{Binding CloseAfterLaunchText}"
                      OffContent="{Binding CloseAfterLaunchText}" />
        <TextBlock Classes="caption muted" Text="{Binding TrayHint}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="2">
        <ToggleSwitch IsChecked="{Binding LaunchAtLogin}"
                      OnContent="{Binding LaunchAtLoginText}"
                      OffContent="{Binding LaunchAtLoginText}" />
        <TextBlock Classes="caption muted" Text="{Binding LaunchAtLoginHint}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="2">
        <ToggleSwitch IsChecked="{Binding AllowParallelDesktop}"
                      OnContent="{Binding ParallelDesktopText}"
                      OffContent="{Binding ParallelDesktopText}" />
        <TextBlock Classes="caption muted" Text="{Binding ParallelDesktopHint}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="2">
        <ToggleSwitch IsChecked="{Binding RecordClaudeLimits}"
                      OnContent="{Binding RecordClaudeLimitsText}"
                      OffContent="{Binding RecordClaudeLimitsText}" />
        <TextBlock Classes="caption muted" Text="{Binding RecordClaudeLimitsHint}" TextWrapping="Wrap" />
        <TextBlock Classes="caption"
                   Foreground="{DynamicResource Mcacc.Danger}"
                   Text="{Binding StatusLineForeign}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding StatusLineForeign, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Classes="body" Text="{Binding ProjectsLabel}" />
        <TextBlock Classes="caption muted" Text="{Binding ProjectsHint}" TextWrapping="Wrap" />
        <TextBlock Classes="caption muted"
                   Text="{Binding ProjectsStatus}"
                   IsVisible="{Binding ProjectsStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ItemsControl ItemsSource="{Binding Projects}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectChoiceViewModel">
              <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Path}">
                <CheckBox IsChecked="{Binding IsCounted}">
                  <StackPanel>
                    <TextBlock Classes="body" Text="{Binding Name}" />
                    <TextBlock Classes="caption muted" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </CheckBox>
                <TextBlock Grid.Column="1"
                           Classes="caption muted"
                           Text="{Binding TokensText}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="body" Text="{Binding DataFolderLabel}" />
        <TextBlock Classes="mono" Text="{Binding DataFolder}" />
        <Button Classes="ghost"
                Content="{Binding RevealText}"
                Command="{Binding RevealDataFolderCommand}"
                HorizontalAlignment="Left" />
      </StackPanel>

      <TextBlock Classes="caption muted" Text="{Binding VersionText}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
