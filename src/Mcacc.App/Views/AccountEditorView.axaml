<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mcacc.App.ViewModels"
             xmlns:controls="using:Mcacc.App.Controls"
             xmlns:model="using:Mcacc.Core.Model"
             x:Class="Mcacc.App.Views.AccountEditorView"
             x:DataType="vm:AccountEditorViewModel">

  <StackPanel Spacing="12">
    <TextBlock Classes="h2" Text="{Binding Title}" />

    <StackPanel Spacing="4">
      <TextBlock Classes="caption" Text="{Binding NameLabel}" />
      <TextBox Text="{Binding Name}" PlaceholderText="{Binding NameWatermark}" />
      <TextBlock Classes="caption danger"
                 Text="{Binding NameError}"
                 IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <StackPanel Spacing="6" IsVisible="{Binding IsCreate}">
      <TextBlock Classes="caption" Text="{Binding ProviderLabel}" />
      <ItemsControl ItemsSource="{Binding Providers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProviderChoiceViewModel">
            <RadioButton Margin="0,0,16,0"
                         Content="{Binding Label}"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         GroupName="Provider"
                         Command="{Binding $parent[ItemsControl].((vm:AccountEditorViewModel)DataContext).PickProviderCommand}"
                         CommandParameter="{Binding Kind}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Classes="caption" Text="{Binding ColorLabel}" />
      <ItemsControl ItemsSource="{Binding Swatches}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ColorSwatchViewModel">
            <Button Width="28"
                    Height="28"
                    Margin="0,0,8,0"
                    Padding="0"
                    CornerRadius="14"
                    BorderThickness="0"
                    Background="{Binding Color, Converter={x:Static vm:ColorConverters.ToBrush}}"
                    Command="{Binding $parent[ItemsControl].((vm:AccountEditorViewModel)DataContext).PickColorCommand}"
                    CommandParameter="{Binding Color}"
                    ToolTip.Tip="{Binding Color}">
              <controls:MIcon Kind="Check"
                              FontSize="16"
                              Foreground="White"
                              IsVisible="{Binding IsSelected}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="6" IsVisible="{Binding IsCreate}">
      <TextBlock Classes="caption" Text="{Binding CopyFromLabel}" />
      <ComboBox ItemsSource="{Binding CopySources}"
                SelectedItem="{Binding CopySource}"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="model:Account">
            <TextBlock Text="{Binding Name, FallbackValue='Nichts'}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Spacing="2" IsVisible="{Binding HasCopySource}">
        <!-- Bounded, so the dialog's buttons stay visible however many items the source offers. -->
        <ScrollViewer MaxHeight="112" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding CopyItemsToShow}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CopyItemViewModel">
                <CheckBox Content="{Binding Label}"
                          IsChecked="{Binding IsSelected}"
                          IsEnabled="{Binding IsAvailable}"
                          MinHeight="24" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <CheckBox Content="{Binding RewritePathsText}"
                  IsVisible="{Binding HasOptionalRewrite}"
                  IsChecked="{Binding RewriteSettingsPaths}"
                  Margin="20,0,0,0" />
      </StackPanel>
    </StackPanel>

    <TextBlock Classes="caption danger"
               Text="{Binding SubmitError}"
               IsVisible="{Binding SubmitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="ghost" Content="{Binding CancelText}" Command="{Binding RejectCommand}" />
      <Button Classes="accent" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</UserControl>
