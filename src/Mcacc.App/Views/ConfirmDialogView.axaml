<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mcacc.App.ViewModels"
             x:Class="Mcacc.App.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">

  <StackPanel Spacing="14">
    <TextBlock Classes="h2" Text="{Binding Title}" />
    <TextBlock Classes="body" Text="{Binding Text}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="ghost" Content="{Binding CancelText}" Command="{Binding RejectCommand}" />
      <Button Classes="accent"
              Content="{Binding ConfirmText}"
              Command="{Binding ConfirmCommand}"
              IsDefault="True" />
    </StackPanel>
  </StackPanel>

</UserControl>
